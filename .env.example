# Thesis — configuration (copy to .env and fill in what you have; .env is gitignored).
# Every key is OPTIONAL: with none set, keyed providers run in fixture mode or
# return disclosed gaps, FINRA and the FRED CSV fallback remain keyless, and the
# pipeline still produces a valid data-only report. SEC EDGAR additionally needs
# the declared contact configured below before its live acquisition path runs.

# --- API keys -----------------------------------------------------------------

# Financial Modeling Prep key — any plan. Lower tiers cap the `limit` parameter
# (5 periods on the entry plans), restrict some endpoints, and on the entry
# plans restrict which symbols are served at all; Thesis reads the cap from
# FMP's own rejection, retries within it, and discloses the truncated history
# depth in the report's missing-data manifest. Restricted endpoints (insider
# trades, institutional ownership, news, transcripts) become disclosed gaps,
# and the members an uncovered symbol loses are served from EDGAR and Yahoo.
#
# Without a key, real tickers are served from SEC EDGAR (statements, shares)
# and Yahoo's chart endpoint (prices); set EDGAR_CONTACT below. DEMO/DBNK stay
# fixtures. See the README's "Without an FMP subscription" section for what is
# served from where and what still has no keyless source.
FMP_API_KEY=

# Anthropic — enables the bull/bear/judge LLM passes + web search.
# Without it, the pipeline degrades to a data-only report (Stage A/B only).
ANTHROPIC_API_KEY=

# FRED — free key from https://fred.stlouisfed.org/docs/api/api_key.html
# The macro dashboard. A keyless fredgraph.csv fallback exists for smoke tests.
FRED_API_KEY=

# Finnhub — free-tier key. Insider sentiment (MSPR) + optional sector modules.
FINNHUB_API_KEY=

# --- SEC EDGAR contact --------------------------------------------------------

# SEC EDGAR is keyless but REQUIRES a declared contact in the User-Agent of every
# request. Set this to your own contact — format "Your Name your-email@example.com".
# If it is unset or still a placeholder, live EDGAR acquisition is disabled and
# the missing source is disclosed in the report rather than sending an anonymous
# request. Configure a real identity before using any live SEC data path.
EDGAR_CONTACT=

# --- Analysis pipeline tuning -------------------------------------------------

# Model used for the analysis pipeline (bull/bear/judge passes).
# "auto" resolves at runtime to the best model available to your key, in
# preference order claude-opus-5 -> claude-opus-4-8 -> claude-sonnet-5 ->
# claude-fable-5-1 -> claude-fable-5. Opus 5 and Opus 4.8 cost the same, so the
# newer one leads and the older is the fallback when a key cannot reach it. The
# Fable models are last (safety-classifier false positives on finance content,
# longer turns, twice the Opus price) — set one explicitly to opt into a
# "deep-dive" mode. The in-app Settings page overrides this without a restart.
#
# Accepted values are "auto" or one model id from the registry
# (config/models.json): claude-fable-5-1, claude-fable-5, claude-opus-5,
# claude-opus-4-8, claude-sonnet-5, claude-haiku-4-5. Dated snapshot ids are
# accepted only where the registry lists one — today that is
# claude-haiku-4-5-20251001 alone. From the 4.6 generation on, the dateless id
# IS the pinned snapshot and dated variants such as claude-opus-5-20260115 do
# not exist, so they are rejected with a message naming the id to use. The
# scheduler cannot prove a spend bound for an unknown id either, so anything
# else is rejected at model resolution and the run degrades to a data-only
# report.
#
# claude-haiku-4-5 does not apply to the whole run: the synthesis/judge pass is
# raised to claude-sonnet-5 and the substitution is disclosed in the report's
# execution metadata as a "model-floor" adjustment, which also records that
# Haiku analyst passes ignore ANALYSIS_EFFORT (the model rejects the parameter).
#
# (The former VERIFY_MODEL var was removed: verification is deterministic
# numeric-source tracing and never calls a model.)
ANALYSIS_MODEL=auto

# Reasoning effort for the LLM passes: low | medium | high | xhigh | max.
# Thinking tokens are billed as output and are the largest cost component per
# report, so this is the main cost/quality knob. Defaults to "high"; also
# overridable on the Settings page. An unrecognized value degrades to "high".
# At high, xhigh and max a request also raises max_tokens to the model's
# registry output ceiling, so a long answer is never truncated mid-document.
# Models that do not accept the parameter (claude-haiku-4-5) ignore it, and
# the report says so.
ANALYSIS_EFFORT=high

# Optional Admin API key (distinct from ANTHROPIC_API_KEY). Only
# `npm run costs:reconcile` reads it, to lower presumed spend against
# Anthropic's reported totals; no report path ever uses it.
ANTHROPIC_ADMIN_KEY=

# --- Durable job scheduling and spend controls -------------------------------

# Cross-process concurrency is enforced in SQLite. Keep these conservative on
# a laptop; increasing them can multiply provider traffic and paid exposure.
#
# Lease invariants checked at startup (the process refuses to start otherwise):
# THESIS_JOB_LEASE_SECONDS covers at least two 300-second job heartbeats and is
# never shorter than THESIS_PAID_PASS_LEASE_SECONDS, which in turn outlives the
# 600-second provider request timeout plus the margin an abandoned stream needs
# to settle.
THESIS_MAX_ACTIVE_JOBS=1
THESIS_MAX_ACTIVE_LLM_CALLS=2

# Optional exact USD caps. Blank disables that cap; 0 denies positive paid
# work. Values accept ordinary nonnegative decimals with at most 6 places and
# must remain exactly representable when converted to micro-USD.
#
# These are compared against RESERVATIONS plus settled spend. In the default
# request mode a reservation is one provider request's maximum ($3.86 for a
# Sonnet 5 analyst request), so a cap of a few dollars is workable: a complete
# measured run came to about $1.43. In pass mode a reservation covers every
# request a pass could make ($138.96 on Sonnet 5), so a cap near real spend
# would reject every job before it starts. Size these off the generated table
# in the README (`npm run docs:pricing`).
THESIS_MAX_JOB_COST_USD=
THESIS_MAX_ROLLING_COST_USD=

# How paid work is admitted against these caps:
#   request (default) — every provider request reserves its own maximum and
#     settles its own usage, so a cap can sit near real spend. One Sonnet 5
#     analyst request reserves $3.86; a complete run settles around $1.
#   pass — the pre-remediation bound: one reservation per pass covering every
#     retry and resumption it could make ($138.96 on Sonnet 5). Kept for one
#     release so a deployment can fall back without a downgrade.
# `npm run docs:pricing` prints the current table for every model.
THESIS_RESERVATION_MODE=request

# A paid pass whose durable lease expires without settling is recorded at its
# FULL reserved maximum ("presumed spend") rather than being returned to these
# caps: the process may have died mid-request and Anthropic may still have
# billed it. Only evidence lowers it — a late settlement for the same attempt,
# or `npm run costs:reconcile` against the Usage & Cost API.

# Gap with no stream event after which a paid request is abandoned. Every paid
# pass streams, so this is what stops a provider that accepts a request and
# then goes silent from holding a lease until the 600-second transport timeout.
# The abandoned attempt settles the usage it reported plus a presumed worst
# case for the rest of the response. 0 disables the guard.
THESIS_STREAM_IDLE_SECONDS=120
# Maximum supported window: 52,560,000 minutes (100 years).
THESIS_ROLLING_COST_WINDOW_MINUTES=1440

# Anthropic requests hard-timeout after 600 seconds. The paid-pass lease MUST
# be longer so a live request can renew before expiry; 900 seconds is the
# recommended default. Job claims use the same conservative default. Lease
# values are capped at 2,147,483 seconds so Node timers cannot clamp or spin.
THESIS_PAID_PASS_LEASE_SECONDS=900
THESIS_JOB_LEASE_SECONDS=900

# --- Local request security --------------------------------------------------

# `npm run dev` and `npm start` bind to 127.0.0.1 by default. Leave this blank
# to accept loopback Host authorities only. For intentional LAN access, set one
# exact DNS name, dotted IPv4 address, or bracketed IPv6 address, with an exact
# optional port (for example 192.168.1.50:3000). Do not include a scheme, path,
# or comma-separated list. Forwarded/X-Forwarded-Host headers are never trusted.
THESIS_ALLOWED_HOST=

# --- Local database (optional overrides) --------------------------------------

# The SQLite DB defaults to the OS app-data directory (so its WAL/SHM writes do
# not trigger Next.js dev-server rebuilds from inside the repo). Override the
# file with THESIS_DB_PATH, or just the directory with THESIS_DATA_DIR.
# THESIS_DB_PATH=
# THESIS_DATA_DIR=

# One-time migration only. Older builds kept the database at ./data/thesis.db
# inside the repo; that file is now ignored, and startup logs a warning when it
# still exists. Set this to 1 for a single run to copy it (plus its -wal/-shm
# siblings) to the current location. It is ignored when THESIS_DB_PATH is set or
# when a database already exists at the target, so it can never overwrite live
# data. Unset it again afterwards.
# THESIS_IMPORT_LEGACY_DB=1
